<% layout("/layouts/boilerplate") %>

<div class="row mt-3 mb-5">
    <div class="col-12 col-lg-10 mx-auto">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
            <h3 class="mb-0"><%= listing.title %></h3>
            <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
                <div class="d-flex gap-2">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
                    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-danger">Delete</button>
                    </form>
                </div>
            <% } %>
        </div>

        <div class="card show-card mx-auto">
            <img src="<%= listing.image?.url %>" class="card-img-top show-img" alt="Listing Image">
            <div class="card-body p-4">
                <p class="text-muted mb-2">Owned by <strong><%= listing.owner?.username || 'Unknown' %></strong></p>
                <p class="card-text"><%= listing.description %></p>
                <p class="card-text mb-1"><strong>Price:</strong> &#8377;<%= listing.price.toLocaleString("en-IN") %></p>
                <p class="card-text mb-1"><strong>Location:</strong> <%= listing.location %></p>
                <p class="card-text mb-0"><strong>Country:</strong> <%= listing.country %></p>
            </div>
        </div>

        <div class="mt-4">
            <% if (currUser) { %>
                <hr>
                <h4 class="mb-3">Leave a Review</h4>
                <form action="/listings/<%= listing._id %>/reviews" method="post" class="needs-validation form-panel p-3 p-md-4" novalidate>
                    <div class="mb-3">
                        <label for="rating" class="form-label">Rating</label>
                        <fieldset class="starability-heartbeat">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>

                    <div class="mb-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea name="review[comment]" id="comment" class="form-control" cols="30" rows="5" required></textarea>
                        <div class="invalid-feedback">Please add a comment for your review.</div>
                    </div>
                    <button class="btn btn-outline-dark">Submit</button>
                </form>
            <% } %>

            <hr>
            <h4 class="mb-3">All Reviews</h4>
            <div class="row g-3">
                <% for (let review of listing.reviews) { %>
                    <div class="col-12 col-md-6">
                        <div class="card review-card h-100">
                            <div class="card-body">
                                <h5 class="card-title">@<%= review.author?.username || 'Anonymous' %></h5>
                                <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                                <p class="card-text mb-0"><%= review.comment %></p>
                            </div>
                            <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                <div class="px-3 pb-3">
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                        <button class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        'use strict';
        let forms = document.querySelectorAll('.needs-validation');

        Array.prototype.slice.call(forms).forEach(function(form) {
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>
